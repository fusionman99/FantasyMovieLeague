    function toIsoDate(v) {
        if (!v)
            return '';
        if (typeof v === 'string') {
            if (/^\d{4}-\d{2}-\d{2}$/.test(v))
                return v;
            const d = new Date(v);
            if (!isNaN(d.getTime()))
                return d.toISOString().slice(0, 10);
            return '';
        }
        const d = new Date(v);
        if (isNaN(d.getTime()))
            return '';
        return d.toISOString().slice(0, 10);
    }

    function normYesNo(v) {
        if (v == null || v === '')
            return null;
        const s = String(v).trim().toUpperCase();
        if (s === 'YES' || s === 'Y' || s === 'TRUE' || s === '1')
            return 'YES';
        if (s === 'NO' || s === 'N' || s === 'FALSE' || s === '0')
            return 'NO';
        if (s === 'N/A' || s === 'NA')
            return 'N/A';
        return s;
    }

    function normNum(v) {
        if (v == null || v === '')
            return null;
        const n = Number(String(v).replace(/[$,%\s,]/g, ''));
        return isNaN(n) ? null : n;
    }

    /** Form input: blank = null; 85 or 85.5 → 0.855; 0.85 stays 0.85 */
    function parseRtScoreFormInput(raw) {
        const s = String(raw ?? '').trim();
        if (s === '')
            return null;
        const n = Number(s);
        if (isNaN(n))
            return null;
        return n > 1 ? n / 100 : n;
    }

    /** OMDb Rotten Tomatoes value often "85%" */
    function parseOmdbRtPercentString(rtVal) {
        if (rtVal == null || rtVal === '')
            return null;
        const s = String(rtVal).replace(/%/g, '').trim();
        const n = parseFloat(s);
        return isNaN(n) ? null : n;
    }

    function formatRtScoreForForm(rtScore) {
        if (rtScore == null || rtScore === '')
            return '';
        const n = Number(rtScore);
        if (isNaN(n))
            return '';
        const pct = n <= 1 ? n * 100 : n;
        return String(Math.round(pct * 10) / 10).replace(/\.0$/, '');
    }

    function rowToMovie(row) {
        return normalizeMovie({
            title: row[SHEET_COLS.movieTitle],
            player: row[SHEET_COLS.draftedBy],
            date: toIsoDate(row[SHEET_COLS.date]),
            type: row[SHEET_COLS.releaseType] || 'Limited',
            gross: row[SHEET_COLS.boxOfficeTotal] != null && row[SHEET_COLS.boxOfficeTotal] !== '' ? normNum(row[SHEET_COLS.boxOfficeTotal]) : normNum(row[SHEET_COLS.boxOffice]),
            rt: normYesNo(row[SHEET_COLS.freshRt]),
            num1: normYesNo(row[SHEET_COLS.numberOne]),
            status: row[SHEET_COLS.status] || null,
            imdbId: row[SHEET_COLS.imdbId] || null,
            poster: row[SHEET_COLS.posterUrl] ? String(row[SHEET_COLS.posterUrl]).trim() || null : null,
            rtScore: (function() {
                const raw = row[SHEET_COLS.rtScore];
                const n = normNum(raw);
                if (n == null)
                    return null;
                return n > 1 ? n / 100 : n;
            })()
        });
    }

    function movieToSheetRow(m) {
        const rtScorePct = m.rtScore == null ? '' : Math.round(Number(m.rtScore) * 100);
        return {
            [SHEET_COLS.draftedBy]: m.player || '',
            [SHEET_COLS.date]: m.date || '',
            [SHEET_COLS.movieTitle]: m.title || '',
            [SHEET_COLS.releaseType]: m.type || '',
            [SHEET_COLS.boxOffice]: m.gross == null ? '' : Number(m.gross),
            [SHEET_COLS.freshRt]: m.rt || '',
            [SHEET_COLS.numberOne]: m.num1 || '',
            [SHEET_COLS.boxOfficeTotal]: m.gross == null ? '' : Number(m.gross),
            [SHEET_COLS.status]: m.status || '',
            [SHEET_COLS.rtScore]: rtScorePct === '' ? '' : rtScorePct,
            [SHEET_COLS.imdbId]: m.imdbId || '',
            [SHEET_COLS.posterUrl]: m.poster || ''
        };
    }

    function normalizeMovie(m) {
        if (!m || typeof m !== 'object')
            return null;
        return {
            id: m.id || genId(),
            title: m.title || '',
            player: m.player || '',
            date: toIsoDate(m.date || ''),
            type: m.type || 'Limited',
            gross: m.gross == null || m.gross === '' ? null : Number(m.gross),
            rt: m.rt == null ? null : m.rt,
            num1: m.num1 == null ? null : m.num1,
            status: m.status == null ? null : m.status,
            imdbId: m.imdbId == null ? null : m.imdbId,
            poster: m.poster == null ? null : m.poster,
            rtScore: m.rtScore == null || m.rtScore === '' ? null : Number(m.rtScore)
        };
    }

    function normalizeDataPayload(payload) {
        let movies = [];
        if (Array.isArray(payload && payload.movies)) {
            movies = payload.movies.map(normalizeMovie).filter(Boolean);
        } else if (Array.isArray(payload && payload.rows)) {
            movies = payload.rows.map(rowToMovie).filter(Boolean);
        }
        const out = {
            movies
        };
        if (payload && payload.newsletter && typeof payload.newsletter === 'object' && Array.isArray(payload.newsletter.stories))
            out.newsletter = payload.newsletter;
        if (payload && Array.isArray(payload.newsletterArchive))
            out.newsletterArchive = payload.newsletterArchive;
        return out;
    }

    function applyDefaultPatches() {
        if (!DATA || !Array.isArray(DATA.movies))
            DATA = {
                movies: []
            };
        DEFAULT_DATA.movies.forEach(def => {
            const existing = DATA.movies.find(m => m.id === def.id);
            if (existing) {
                if (!existing.imdbId && def.imdbId)
                    existing.imdbId = def.imdbId;
                if (existing.rtScore == null && def.rtScore != null)
                    existing.rtScore = def.rtScore;
                if (existing.gross !== def.gross && def.gross != null)
                    existing.gross = def.gross;
                if (existing.rt !== def.rt && def.rt != null)
                    existing.rt = def.rt;
                if (existing.num1 !== def.num1 && def.num1 != null)
                    existing.num1 = def.num1;
                if (def.poster && def.poster.startsWith('data:'))
                    existing.poster = def.poster;
            }
        });
    }

    function hasGoogleSheetsSync() {
        return !!GOOGLE_SHEETS_WEB_APP_URL;
    }

    async function fetchSheetsData() {
        if (!hasGoogleSheetsSync())
            return null;
        const url = new URL(GOOGLE_SHEETS_WEB_APP_URL);
        if (GOOGLE_SHEETS_API_KEY)
            url.searchParams.set('key', GOOGLE_SHEETS_API_KEY);
        url.searchParams.set('t', Date.now().toString());
        const resp = await fetch(url.toString(), {
            method: 'GET',
            cache: 'no-store'
        });
        if (!resp.ok)
            throw new Error('Sheets GET failed: ' + resp.status);
        const payload = await resp.json();
        return normalizeDataPayload(payload);
    }

    async function pushSheetsData() {
        if (!hasGoogleSheetsSync())
            return;
        ensureNewsletter();
        ensureNewsletterArchive();
        const payload = JSON.stringify({
            key: GOOGLE_SHEETS_API_KEY || null,
            movies: DATA.movies,
            rows: DATA.movies.map(movieToSheetRow),
            newsletter: DATA.newsletter,
            newsletterArchive: DATA.newsletterArchive || [],
            updatedAt: new Date().toISOString()
        });
        const resp = await fetch(GOOGLE_SHEETS_WEB_APP_URL, {
            method: 'POST',
            headers: {
                'Content-Type': 'text/plain;charset=UTF-8'
            },
            body: payload
        });
        const respText = await resp.text();
        if (!resp.ok)
            throw new Error('Sheets POST failed: ' + resp.status + ' ' + respText.slice(0, 200));
        try {
            var jr = JSON.parse(respText);
            if (jr && jr.error)
                throw new Error(String(jr.error));
        } catch (parseErr) {
            if (parseErr instanceof SyntaxError)
                return;
            throw parseErr;
        }
    }

    function queueSheetsSync() {
        if (!hasGoogleSheetsSync())
            return;
        clearTimeout(remoteSyncTimer);
        remoteSyncTimer = setTimeout(async function() {
            try {
                await pushSheetsData();
            } catch (err) {
                console.warn('Google Sheets sync failed', err);
                showToast('Google Sheets sync failed. Data is still saved locally.', 'error');
            }
        }, 500);
    }

    async function loadData() {
        try {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                const parsed = JSON.parse(saved);
                if (parsed.movies && parsed.movies.length >= DEFAULT_DATA.movies.length) {
                    DATA = normalizeDataPayload(parsed);
                    if (parsed.newsletter)
                        DATA.newsletter = parsed.newsletter;
                    if (parsed.newsletterArchive)
                        DATA.newsletterArchive = parsed.newsletterArchive;
                }
            }
        } catch (e) {}
        if (!DATA)
            DATA = JSON.parse(JSON.stringify(DEFAULT_DATA));
        applyDefaultPatches();
        ensureNewsletter();
        ensureNewsletterArchive();

        if (hasGoogleSheetsSync()) {
            try {
                const remote = await fetchSheetsData();
                if (remote && Array.isArray(remote.movies) && remote.movies.length) {
                    const keepNw = DATA.newsletter;
                    const keepArch = DATA.newsletterArchive;
                    DATA = normalizeDataPayload(remote);
                    if (remote.newsletter && Array.isArray(remote.newsletter.stories))
                        DATA.newsletter = remote.newsletter;
                    else if (keepNw)
                        DATA.newsletter = keepNw;
                    if (remote.newsletterArchive && Array.isArray(remote.newsletterArchive))
                        DATA.newsletterArchive = remote.newsletterArchive;
                    else if (keepArch)
                        DATA.newsletterArchive = keepArch;
                    applyDefaultPatches();
                    ensureNewsletter();
                    ensureNewsletterArchive();
                    saveData({
                        skipRemote: true
                    });
                    return;
                }
            } catch (err) {
                console.warn('Google Sheets load failed, using local data', err);
                showToast('Google Sheets unavailable. Using local data.', 'error');
            }
        }

        saveData({
            skipRemote: true
        });
    }

    function saveData(opts={}) {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(DATA));
        } catch (e) {}
        if (!opts.skipRemote)
            queueSheetsSync();
    }

    function ensureNewsletter() {
        if (!DATA)
            return;
        if (!DATA.newsletter || typeof DATA.newsletter !== 'object' || !Array.isArray(DATA.newsletter.stories))
            DATA.newsletter = JSON.parse(JSON.stringify(DEFAULT_NEWSLETTER));
    }

    function ensureNewsletterArchive() {
        if (!DATA)
            return;
        if (!Array.isArray(DATA.newsletterArchive))
            DATA.newsletterArchive = [];
    }

    function newsletterIssueHasContent(x) {
        if (!x)
            return false;
        if ((x.headline && String(x.headline).trim()) || (x.deck && String(x.deck).trim()) || (x.footer && String(x.footer).trim()))
            return true;
        const st = x.stories;
        if (!Array.isArray(st))
            return false;
        return st.some(s => s && (s.hed || s.body || s.imageUrl || s.caption));
    }

    function nwEscapeHtml(s) {
        if (s == null || s === '')
            return '';
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function nwBodyToHtml(body) {
        return nwEscapeHtml(body).replace(/\n/g, '<br>');
    }

    function renderNewsletterIssueBlockHtml(n) {
        if (!n)
            return '';
        const stories = (n.stories || []).filter(s => s && (s.hed || s.body || s.imageUrl || s.caption));
        let html = `
    <div class="news-issue">${nwEscapeHtml(n.issue)}</div>
    <div class="news-headline">${nwEscapeHtml(n.headline)}</div>
    <div class="news-deck">${nwEscapeHtml(n.deck)}</div>`;
        stories.forEach((s, i) => {
            const col = NW_HED_COLORS[i % NW_HED_COLORS.length];
            const src = String(s.imageUrl || '').replace(/"/g, '&quot;');
            html += `
    <div class="news-story">
      <div class="news-story-hed" style="color:${col}">${nwEscapeHtml(s.hed)}</div>
      ${src ? `<img class="news-img" src="${src}" alt="">` : ''}
      ${s.caption ? `<div class="news-img-cap">${nwEscapeHtml(s.caption)}</div>` : ''}
      <div class="news-story-body">${nwBodyToHtml(s.body)}</div>
    </div>`;
            if (i < stories.length - 1)
                html += '<hr class="news-divider">';
        });
        if (n.footer)
            html += `<div class="news-footer" style="margin-top:32px;">${nwEscapeHtml(n.footer)}</div>`;
        return html;
    }

    function renderNewsletterArchive() {
        const list = document.getElementById('newsletter-archive-list');
        if (!list)
            return;
        ensureNewsletterArchive();
        const arch = DATA.newsletterArchive || [];
        if (!arch.length) {
            list.innerHTML = '<p class="form-hint" style="padding:8px 0;color:var(--muted)">No archived issues yet. When you change the Issue label and save, the previous issue appears here.</p>';
            return;
        }
        list.innerHTML = arch.map(function(issue, idx) {
            const aid = 'archive-' + idx;
            const label = nwEscapeHtml(issue.issue || ('Archived issue ' + (idx + 1)));
            const inner = renderNewsletterIssueBlockHtml(issue);
            return `<div class="news-issue-toggle" id="toggle-${aid}" onclick="toggleIssue('${aid}')">
  <div>
    <div class="news-issue-toggle-label">${label}</div>
    <div class="news-issue-toggle-meta">Archived newsletter</div>
  </div>
  <span class="news-issue-toggle-arrow">▼</span>
</div>
<div class="news-issue-body" id="body-${aid}">
  <div style="padding:0">${inner}</div>
</div>`;
        }).join('');
    }

    function renderNewsletter() {
        const ci = document.getElementById('current-issue');
        if (!ci)
            return;
        ensureNewsletter();
        ci.innerHTML = renderNewsletterIssueBlockHtml(DATA.newsletter);
        renderNewsletterArchive();
    }

    function fillNewsletterForm() {
        ensureNewsletter();
        const n = DATA.newsletter;
        document.getElementById('nw-issue').value = n.issue || '';
        document.getElementById('nw-headline').value = n.headline || '';
        document.getElementById('nw-deck').value = n.deck || '';
        document.getElementById('nw-footer').value = n.footer || '';
        document.querySelectorAll('#nw-story-slots .nw-slot').forEach((slot, i) => {
            const s = (n.stories && n.stories[i]) || {};
            slot.querySelector('.nw-st-hed').value = s.hed || '';
            slot.querySelector('.nw-st-img').value = s.imageUrl || '';
            slot.querySelector('.nw-st-cap').value = s.caption || '';
            slot.querySelector('.nw-st-body').value = s.body || '';
        });
    }

    async function saveNewsletter() {
        ensureNewsletter();
        const stories = [];
        document.querySelectorAll('#nw-story-slots .nw-slot').forEach(slot => {
            const hed = slot.querySelector('.nw-st-hed').value.trim();
            const imageUrl = slot.querySelector('.nw-st-img').value.trim();
            const caption = slot.querySelector('.nw-st-cap').value.trim();
            const body = slot.querySelector('.nw-st-body').value.trim();
            if (hed || body || imageUrl || caption)
                stories.push({
                    hed,
                    imageUrl,
                    caption,
                    body
                });
        });
        const prevSnap = JSON.parse(JSON.stringify(DATA.newsletter));
        const newIss = document.getElementById('nw-issue').value.trim();
        const oldIss = (prevSnap.issue || '').trim();
        const nextNewsletter = {
            issue: newIss,
            headline: document.getElementById('nw-headline').value.trim(),
            deck: document.getElementById('nw-deck').value.trim(),
            footer: document.getElementById('nw-footer').value.trim(),
            stories
        };
        if (oldIss && newIss && oldIss !== newIss && newsletterIssueHasContent(prevSnap)) {
            ensureNewsletterArchive();
            DATA.newsletterArchive.unshift(prevSnap);
            if (DATA.newsletterArchive.length > 40)
                DATA.newsletterArchive.length = 40;
        }
        DATA.newsletter = nextNewsletter;
        saveData({
            skipRemote: true
        });
        renderNewsletter();
        buildNewsPreview();
        if (!hasGoogleSheetsSync()) {
            showToast('Newsletter saved locally', 'success');
            return;
        }
        try {
            await pushSheetsData();
            showToast('Newsletter saved & synced to Sheets', 'success');
        } catch (err) {

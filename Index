    function loadPoster(m, pid) {
        const posterSrc = m.poster;
        const fetchKey = m.imdbId || m.title;

        const applyPoster = (src, rtScore) => {
            const wrap = document.getElementById(pid);
            if (!wrap)
                return;
            // Use provided src, or fall back to embedded poster on movie object
            const finalSrc = src || m.poster || null;
            if (finalSrc) {
                const img = new Image();
                img.src = finalSrc;
                img.onload = () => {
                    const ph = wrap.querySelector('.poster-ph');
                    if (ph)
                        ph.remove();
                    wrap.insertBefore(img, wrap.firstChild);
                };
                img.onerror = () => {
                    // If OMDB url failed, try embedded poster
                    if (src && m.poster && src !== m.poster) {
                        const img2 = new Image();
                        img2.src = m.poster;
                        img2.onload = () => {
                            const ph = wrap.querySelector('.poster-ph');
                            if (ph)
                                ph.remove();
                            wrap.insertBefore(img2, wrap.firstChild);
                        };
                    } else {
                        const ph = wrap.querySelector('.poster-ph');
                        if (ph) {
                            ph.classList.remove('loading');
                            ph.querySelector('.poster-ph-txt').textContent = 'No Poster';
                        }
                    }
                };
            } else {
                const ph = wrap.querySelector('.poster-ph');
                if (ph) {
                    ph.classList.remove('loading');
                    ph.querySelector('.poster-ph-txt').textContent = 'No Poster';
                }
            }
            // Use OMDB RT score or fall back to spreadsheet rtScore
            const displayRt = rtScore || (m.rtScore ? Math.round(m.rtScore * 100) + '%' : null);
            if (displayRt) {
                const rb = document.createElement('div');
                rb.className = 'p-rt';
                rb.style.cssText = `bottom:${bonusType(m) ? '28px' : '5px'};left:5px;color:${parseInt(displayRt) >= 60 ? 'var(--bonus-rt)' : 'var(--red)'}`;
                rb.innerHTML = `<img src="${parseInt(displayRt) >= 60 ? RT_FRESH : RT_ROTTEN}" style="width:14px;height:14px;vertical-align:middle;margin-right:2px">${displayRt}`;
                const w2 = document.getElementById(pid);
                if (w2)
                    w2.appendChild(rb);
            }
        };

        // If we have an embedded poster, show it immediately then still try OMDB for RT score
        if (posterSrc) {
            applyPoster(posterSrc, null);
            // Still fetch RT score from OMDB if we don't have it from sheet
            if (!m.rtScore) {
                fetchOMDB(fetchKey, !!m.imdbId).then(d => {
                    if(d?.rt) {
                        const displayRt = d.rt;
                        const rb = document.createElement('div');
                        rb.className = 'p-rt';
                        rb.style.cssText = 'bottom:' + (bonusType(m) ? '28px' : '5px') + ';left:5px;color:' + (parseInt(displayRt) >= 60 ? 'var(--bonus-rt)' : 'var(--red)');
                        rb.innerHTML = `<img src="${parseInt(displayRt) >= 60 ? RT_FRESH : RT_ROTTEN}" style="width:14px;height:14px;vertical-align:middle;margin-right:2px">${displayRt}`;
                        const w2 = document.getElementById(pid);
                        if (w2)
                            w2.appendChild(rb);
                    }
                });
            }
            return;
        }

        fetchOMDB(fetchKey, !!m.imdbId).then(d => {
            if (d) {
                applyPoster(d.poster, d.rt);
                // Cache poster on movie object
                if (d.poster && !m.poster) {
                    const mov = DATA.movies.find(x => x.id === m.id);
                    if (mov) {
                        mov.poster = d.poster;
                        saveData();
                    }
                }
            } else {
                applyPoster(null, null);
            }
        });
    }


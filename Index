    // ─── HELPERS ────────────────────────────────────────────────────────────────
    function fmt(n) {
        if (n == null)
            return '—';
        if (n === 0)
            return '$0';
        if (n >= 1e9)
            return '$' + (n / 1e9).toFixed(2) + 'B';
        if (n >= 1e6)
            return '$' + (n / 1e6).toFixed(1) + 'M';
        if (n > 0)
            return '$' + n.toLocaleString();
        return '—';
    }
    function fmtFull(n) {
        if (n == null || n < 0)
            return '—';
        if (n === 0)
            return '$0';
        return '$' + n.toLocaleString();
    }
    function genId() {
        return 'm' + Date.now() + Math.random().toString(36).slice(2, 6);
    }
    function movieBonus(m) {
        if (m.gross == null)
            return 0;
        let b = 0;
        if (m.rt === 'YES')
            b += BONUS;
        if (m.num1 === 'YES' && m.gross > 0)
            b += BONUS;
        return b;
    }
    function bonusType(m) {
        const r = m.rt === 'YES' && m.gross > 0;
        const n = m.num1 === 'YES' && m.gross > 0;
        if (r && n)
            return 'both';
        if (r)
            return 'rt';
        if (n)
            return 'num1';
        return null;
    }
    function playerMovies(p) {
        return DATA.movies.filter(m => m.player === p);
    }
    function playerBase(p) {
        return playerMovies(p).reduce((a, m) => a + (m.gross > 0 ? m.gross : 0), 0);
    }
    function playerBonusTotal(p) {
        return playerMovies(p).reduce((a, m) => a + movieBonus(m), 0);
    }
    function playerTotal(p) {
        return playerBase(p) + playerBonusTotal(p);
    }
    function getSortedLB() {
        const players = [...new Set(DATA.movies.map(m => m.player))];
        return players.map(p => ({
            player: p,
            gross: playerTotal(p),
            base: playerBase(p),
            bonus: playerBonusTotal(p)
        }))
        .sort((a, b) => b.gross - a.gross).map((e, i) => ({
            ...e,
            pos: i + 1
        }));
    }

    // ─── OMDB ────────────────────────────────────────────────────────────────────
    async function fetchOMDB(titleOrId, isId=false) {
        const key = titleOrId;
        if (omdbCache[key] !== undefined)
            return omdbCache[key];
        try {
            const param = isId ? `i=${encodeURIComponent(titleOrId)}` : `t=${encodeURIComponent(titleOrId)}`;
            const r = await fetch(`https://www.omdbapi.com/?${param}&apikey=${OMDB_KEY}`);
            const d = await r.json();
            if (d.Response === 'True') {
                const rtR = d.Ratings && d.Ratings.find(x => x.Source === 'Rotten Tomatoes');
                const res = {
                    poster: d.Poster && d.Poster !== 'N/A' ? d.Poster : null,
                    imdb: d.imdbRating && d.imdbRating !== 'N/A' ? d.imdbRating : null,
                    rt: rtR ? rtR.Value : null,
                    meta: d.Metascore && d.Metascore !== 'N/A' ? d.Metascore : null,
                    plot: d.Plot && d.Plot !== 'N/A' ? d.Plot : null,
                    runtime: d.Runtime && d.Runtime !== 'N/A' ? d.Runtime : null,
                    boxOffice: d.BoxOffice && d.BoxOffice !== 'N/A' ? d.BoxOffice : null,
                    title: d.Title,
                    year: d.Year,
                    imdbId: d.imdbID,
                };
                omdbCache[key] = res;
                return res;
            }
            omdbCache[key] = null;
            return null;
        } catch (e) {
            omdbCache[key] = null;
            return null;
        }
    }

    async function searchOMDB(query) {
        try {
            const r = await fetch(`https://www.omdbapi.com/?s=${encodeURIComponent(query)}&type=movie&apikey=${OMDB_KEY}`);
            const d = await r.json();
            return d.Response === 'True' ? d.Search : [];
        } catch (e) {
            return [];
        }
    }


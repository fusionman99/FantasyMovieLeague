<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fantasy Movie League 2026</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@400;600;700;800&family=Anton&family=Oswald:wght@700&display=swap" rel="stylesheet">
    <style>
    :root {
        --navy: #060e1e;
        --navy2: #0a1628;
        --navy3: #0d1f3c;
        --card: #0f2040;
        --card2: #112244;
        --border: #1a3a6a;
        --border2: #1e4080;
        --gold: #c9a84c;
        --gold2: #f0c040;
        --gold3: #ffe880;
        --blue: #2a7fff;
        --blue2: #4db8ff;
        --silver: #c8d8f0;
        --text: #e8eaf0;
        --muted: #5a7aaa;
        --muted2: #3a5a8a;
        --green: #44cc66;
        --orange: #ff9944;
        --red: #ff5533;
        --bonus-rt: #44cc66;
        --bonus-n1: #f0c040;
        --bonus-both: #ff9944;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        background: var(--navy);
        color: var(--text);
        font-family: 'Barlow', sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
    }/* HEADER */
    .site-header {
        background: linear-gradient(180deg, #020810, var(--navy2));
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 200;
        padding: 0 20px;
    }

    .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
    }

    .header-logo-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .header-logo-img {
        width: 56px;
        height: 56px;
        object-fit: contain;
        filter: drop-shadow(0 0 10px rgba(201, 168, 76, 0.5));
    }

    .header-title-h {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 27px;
        letter-spacing: 3px;
        background: linear-gradient(135deg, var(--gold2), var(--gold));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .header-title-sub {
        font-size: 12px;
        letter-spacing: 3px;
        color: var(--muted);
        text-transform: uppercase;
        margin-top: 1px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .admin-btn {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: rgba(201, 168, 76, 0.08);
        border: 1px solid rgba(201, 168, 76, 0.3);
        color: var(--gold);
        padding: 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .admin-btn:hover {
        background: rgba(201, 168, 76, 0.15);
    }

    .season-badge {
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--gold);
        border: 1px solid rgba(201, 168, 76, 0.3);
        padding: 4px 10px;
        background: rgba(201, 168, 76, 0.05);
        font-family: 'Barlow Condensed', sans-serif;
    }/* NAV */
    .site-nav {
        background: var(--navy2);
        border-bottom: 2px solid var(--border);
        display: flex;
        justify-content: center;
        overflow-x: auto;
    }

    .nav-btn {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--muted);
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 13px 28px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
        margin-bottom: -2px;
    }

    .nav-btn:hover {
        color: var(--silver);
    }

    .nav-btn.active {
        color: var(--gold2);
        border-bottom-color: var(--gold2);
    }/* TICKER */
    .ticker-wrap {
        display: none;
    }

    .ticker-inner {
        display: flex;
        animation: ticker 28s linear infinite;
        white-space: nowrap;
    }

    .ticker-sep {
        color: var(--border2);
        margin: 0 14px;
    }

    .t-item {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 14px;
        letter-spacing: 2px;
        color: var(--muted);
        text-transform: uppercase;
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }

    .t-name {
        color: var(--silver);
        font-weight: 700;
    }

    .t-val {
        color: var(--gold2);
        font-weight: 800;
    }

    .t-bonus {
        color: var(--bonus-rt);
        font-size: 12px;
    }

    @keyframes ticker {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }/* MAIN */
    .main-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 20px;
    }

    .page {
        display: none;
    }

    .page.active {
        display: block;
    }/* SECTION LABEL */
    .sec-lbl {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 4px;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sec-lbl::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--border), transparent);
    }/* BONUS KEY */
    .bonus-key {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        align-items: center;
        padding: 10px 16px;
        background: var(--card);
        border: 1px solid var(--border);
        margin-bottom: 20px;
    }

    .bk-lbl {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        color: var(--muted);
        text-transform: uppercase;
    }

    .bk-item {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    .bk-note {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        color: var(--muted);
        margin-left: auto;
    }/* HERO */
    .hero-box {
        background: linear-gradient(135deg, var(--navy3), #071828, var(--navy3));
        border: 1px solid var(--border);
        padding: 24px 28px;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
    }

    .hero-box::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 20% 50%, rgba(201, 168, 76, 0.07), transparent 55%), radial-gradient(ellipse at 80% 50%, rgba(42, 127, 255, 0.05), transparent 55%);
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(28px, 5vw, 54px);
        letter-spacing: 4px;
        background: linear-gradient(135deg, var(--gold3), var(--gold2), var(--gold));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
        margin-bottom: 4px;
    }

    .hero-sub {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        color: var(--muted);
        letter-spacing: 3px;
        text-transform: uppercase;
        margin-bottom: 16px;
    }

    .hero-stats {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .hero-stat strong {
        display: block;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 27px;
        letter-spacing: 1px;
        line-height: 1;
    }

    .hero-stat span {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        color: var(--muted);
        letter-spacing: 2px;
        text-transform: uppercase;
    }/* PLAYER CARDS */
    .players-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 14px;
        margin-bottom: 28px;
    }

    .player-card {
        background: var(--card);
        border: 1px solid var(--border);
        overflow: hidden;
        transition: border-color 0.2s;
    }

    .player-card.expanded {
        border-color: var(--gold);
    }

    .pc-top {
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        cursor: pointer;
        user-select: none;
    }

    .pc-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 23px;
        flex-shrink: 0;
        border: 2px solid;
    }

    .pc-info {
        flex: 1;
        min-width: 0;
    }

    .pc-name {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 25px;
        letter-spacing: 2px;
        line-height: 1;
    }

    .pc-sub {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        color: var(--muted);
        margin-top: 2px;
    }

    .pc-gross {
        text-align: right;
        flex-shrink: 0;
    }

    .pc-base {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        color: var(--muted);
        text-decoration: line-through;
    }

    .pc-total {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 21px;
        letter-spacing: 1px;
    }

    .pc-bonus {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: var(--bonus-rt);
    }

    .pc-arrow {
        color: var(--muted);
        font-size: 16px;
        transition: transform 0.3s;
        flex-shrink: 0;
    }

    .player-card.expanded .pc-arrow {
        transform: rotate(180deg);
    }

    .pc-bar-wrap {
        height: 3px;
        background: var(--border);
    }

    .pc-bar {
        height: 100%;
        transition: width 1.2s ease;
    }

    .pc-bonus-bar {
        padding: 7px 16px;
        background: rgba(68, 204, 102, 0.04);
        border-top: 1px solid rgba(68, 204, 102, 0.1);
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .pc-bonus-item {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

    .pc-mini-row {
        display: flex;
        border-top: 1px solid var(--border);
    }

    .pc-mini {
        flex: 1;
        padding: 8px 6px;
        text-align: center;
        border-right: 1px solid var(--border);
    }

    .pc-mini:last-child {
        border-right: none;
    }

    .pc-mini .v {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 17px;
        font-weight: 700;
        display: block;
    }

    .pc-mini .l {
        font-size: 11px;
        letter-spacing: 1px;
        color: var(--muted);
        text-transform: uppercase;
    }/* ROSTER EXPAND */
    .pc-roster {
        display: none;
        border-top: 1px solid var(--border);
        padding: 14px;
    }

    .player-card.expanded .pc-roster {
        display: block;
    }

    .roster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 8px;
    }

    .rm-card {
        background: var(--navy3);
        border: 1px solid var(--border);
        padding: 10px;
        cursor: pointer;
        transition: border-color 0.2s;
        position: relative;
    }

    .rm-card:hover {
        border-color: var(--border2);
    }

    .rm-card.has-bonus {
        border-color: rgba(240, 192, 64, 0.25);
    }

    .rm-icon {
        font-size: 14px;
        margin-bottom: 3px;
    }

    .rm-title {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 4px;
    }

    .rm-gross {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .rm-bonus {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .rm-badges {
        display: flex;
        gap: 3px;
        flex-wrap: wrap;
    }/* BADGE */
    .badge {
        display: inline-block;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 2px 6px;
        border: 1px solid;
        line-height: 1.4;
    }

    .b-theaters {
        color: var(--blue2);
        border-color: rgba(77, 184, 255, 0.35);
        background: rgba(77, 184, 255, 0.07);
    }

    .b-limited {
        color: var(--muted);
        border-color: rgba(90, 122, 170, 0.3);
        background: rgba(90, 122, 170, 0.05);
    }

    .b-rerelease {
        color: #ff9944;
        border-color: rgba(255, 153, 68, 0.3);
        background: rgba(255, 153, 68, 0.05);
    }

    .b-done {
        color: var(--gold);
        border-color: rgba(201, 168, 76, 0.3);
        background: rgba(201, 168, 76, 0.05);
    }

    .b-upcoming {
        color: var(--muted);
        border-color: rgba(90, 122, 170, 0.2);
    }

    .b-fresh {
        color: #44cc66;
        border-color: rgba(68, 204, 102, 0.3);
        background: rgba(68, 204, 102, 0.05);
    }

    .b-rotten {
        color: #ff5533;
        border-color: rgba(255, 85, 51, 0.3);
        background: rgba(255, 85, 51, 0.05);
    }

    .b-never {
        color: #ff5533;
        border-color: rgba(255, 85, 51, 0.3);
        background: rgba(255, 85, 51, 0.05);
    }

    .b-num1 {
        background: var(--gold2);
        color: #000;
        border-color: var(--gold2);
    }

    .b-bonus-rt {
        color: var(--bonus-rt);
        border-color: var(--bonus-rt);
        background: rgba(68, 204, 102, 0.1);
    }

    .b-bonus-n1 {
        color: var(--gold2);
        border-color: var(--gold);
        background: rgba(240, 192, 64, 0.1);
    }

    .b-bonus-both {
        color: var(--bonus-both);
        border-color: var(--bonus-both);
        background: rgba(255, 153, 68, 0.1);
    }/* MOVIES PAGE */
    .filter-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .filter-btn {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--muted);
        padding: 6px 12px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-btn.active, .filter-btn:hover {
        border-color: currentColor;
    }

    .sort-row {
        display: flex;
        gap: 6px;
        margin-bottom: 18px;
        align-items: center;
        flex-wrap: wrap;
    }

    .sort-lbl {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        color: var(--muted);
        text-transform: uppercase;
    }

    .sort-btn {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        background: none;
        border: 1px solid var(--border);
        color: var(--muted);
        padding: 4px 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .sort-btn.active, .sort-btn:hover {
        color: var(--gold2);
        border-color: var(--gold);
    }

    .poster-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 12px;
    }

    .poster-card {
        background: var(--card);
        border: 1px solid var(--border);
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.2s, border-color 0.2s;
    }

    .poster-card:hover {
        transform: translateY(-3px);
    }

    .poster-card.bonus-card {
        border-color: rgba(240, 192, 64, 0.3);
    }

    .poster-img-wrap {
        position: relative;
        aspect-ratio: 2/3;
        background: var(--navy3);
        overflow: hidden;
    }

    .poster-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s;
    }

    .poster-card:hover .poster-img-wrap img {
        transform: scale(1.05);
    }

    .poster-ph {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: var(--muted2);
    }

    .poster-ph-icon {
        font-size: 31px;
        opacity: 0.25;
    }

    .poster-ph-txt {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: 0.5;
    }

    @keyframes shimmer {
        0%, 100% {
            opacity:0.3
        }

        50% {
            opacity: 0.7
        }
    }

    .loading {
        animation: shimmer 1.5s ease infinite;
    }

    .p-strip {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
    }

    .p-gross {
        position: absolute;
        top: 5px;
        right: 5px;
        background: rgba(0, 0, 0, 0.85);
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 13px;
        font-weight: 700;
        padding: 2px 5px;
        letter-spacing: 1px;
    }

    .p-num1 {
        position: absolute;
        top: 5px;
        left: 5px;
        background: var(--gold2);
        color: #000;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 5px;
        letter-spacing: 1px;
    }

    .p-rt {
        position: absolute;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        font-weight: 700;
        padding: 2px 5px;
        letter-spacing: 1px;
        background: rgba(0, 0, 0, 0.85);
    }

    .p-bonus-row {
        position: absolute;
        bottom: 4px;
        left: 4px;
        right: 4px;
        display: flex;
        gap: 3px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .p-bonus-pip {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        font-weight: 800;
        padding: 2px 4px;
        border: 1px solid;
    }

    .poster-info {
        padding: 8px 10px;
    }

    .poster-title {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: 3px;
    }

    .poster-meta {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 5px;
    }

    .poster-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .p-dot {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .p-dot::before {
        content: '';
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
    }/* STATS PAGE */
    .stats-hero {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
        gap: 10px;
        margin-bottom: 26px;
    }

    .sh-card {
        background: var(--card);
        border: 1px solid var(--border);
        padding: 16px;
        text-align: center;
    }

    .sh-card.gold {
        border-color: rgba(201, 168, 76, 0.35);
        background: linear-gradient(135deg, var(--card), #1a2500);
    }

    .sh-card.green {
        border-color: rgba(68, 204, 102, 0.3);
        background: linear-gradient(135deg, var(--card), #002010);
    }

    .sh-card.blue {
        border-color: rgba(42, 127, 255, 0.25);
        background: linear-gradient(135deg, var(--card), #001530);
    }

    .sh-v {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 37px;
        letter-spacing: 2px;
        line-height: 1;
        color: var(--gold2);
    }

    .sh-card.green .sh-v {
        color: var(--bonus-rt);
    }

    .sh-card.blue .sh-v {
        color: var(--blue2);
    }

    .sh-l {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        color: var(--muted);
        text-transform: uppercase;
        margin-top: 3px;
    }

    .sh-s {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
    }

    .charts-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 26px;
    }


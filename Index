    function editMovie(id) {
        const m = DATA.movies.find(x => x.id === id);
        if (!m)
            return;
        editingMovieId = id;
        document.getElementById('form-section-title').textContent = 'Edit Movie';
        document.getElementById('form-delete-btn').style.display = '';
        document.getElementById('f-title').value = m.title;
        document.getElementById('f-player').value = m.player;
        document.getElementById('f-date').value = m.date;
        document.getElementById('f-type').value = m.type;
        document.getElementById('f-gross').value = m.gross != null ? m.gross : '';
        document.getElementById('f-imdbid').value = m.imdbId || '';
        document.getElementById('f-poster').value = m.poster || '';
        document.getElementById('f-rtscore').value = formatRtScoreForForm(m.rtScore);
        document.getElementById('f-status').value = m.status || '';
        document.getElementById('search-title-input').value = m.title;
        document.getElementById('imdb-id-input').value = m.imdbId || '';
        document.getElementById('search-results-area').innerHTML = '';
        document.getElementById('omdb-gross-hint').textContent = '';
        formToggles = {
            rt: m.rt || null,
            num1: m.num1 || null
        };
        updateToggles();

        // Show current OMDB data; fill RT % from OMDb if field still empty
        const fetchKey = m.imdbId || m.title;
        fetchOMDB(fetchKey, !!m.imdbId).then(d => {
            showOMDBPreview(d, m.title);
            if (d) {
                const rtp = parseOmdbRtPercentString(d.rt);
                if (rtp != null && !document.getElementById('f-rtscore').value.trim()) {
                    document.getElementById('f-rtscore').value = String(Math.round(rtp * 10) / 10).replace(/\.0$/, '');
                }
            }
        });

        var fs = document.getElementById('movie-form-section');
        fs.style.display = 'block';
        fs.style.visibility = 'visible';
        setTimeout(function() {
            fs.scrollIntoView({
                behavior: 'smooth'
            });
        }, 50);
    }

    function cancelForm() {
        editingMovieId = null;
        document.getElementById('movie-form-section').style.display = 'none';
        document.getElementById('movie-form-section').style.visibility = '';
        document.getElementById('search-results-area').innerHTML = '';
        document.getElementById('omdb-preview-area').innerHTML = '';
    }

    function saveMovie() {
        const title = document.getElementById('f-title').value.trim();
        const player = document.getElementById('f-player').value;
        const date = document.getElementById('f-date').value;
        const type = document.getElementById('f-type').value;
        const grossRaw = document.getElementById('f-gross').value;
        const imdbId = document.getElementById('f-imdbid').value.trim() || null;
        const posterRaw = document.getElementById('f-poster').value.trim();
        const poster = posterRaw || null;
        const status = document.getElementById('f-status').value || null;
        const rtScore = parseRtScoreFormInput(document.getElementById('f-rtscore').value);

        if (!title || !player || !date) {
            showToast('Please fill in Title, Player and Date', 'error');
            return;
        }

        const gross = grossRaw !== '' ? Number(grossRaw) : null;

        if (editingMovieId) {
            const idx = DATA.movies.findIndex(m => m.id === editingMovieId);
            if (idx !== -1) {
                DATA.movies[idx] = {
                    ...DATA.movies[idx],
                    title,
                    player,
                    date,
                    type,
                    gross,
                    rt: formToggles.rt,
                    num1: formToggles.num1,
                    status,
                    imdbId,
                    poster,
                    rtScore
                };
            }
            showToast('Movie updated!', 'success');
        } else {
            DATA.movies.push({
                id: genId(),
                title,
                player,
                date,
                type,
                gross,
                rt: formToggles.rt,
                num1: formToggles.num1,
                status,
                imdbId,
                poster,
                rtScore
            });
            showToast('Movie added!', 'success');
        }

        saveData();
        cancelForm();
        buildAdminMovieList();
        refreshAll();
    }

    function confirmDelete(id) {
        const m = DATA.movies.find(x => x.id === id);
        if (!m)
            return;
        showConfirm('Delete "' + m.title + '"? This cannot be undone.', function() {
            DATA.movies = DATA.movies.filter(x => x.id !== id);
            saveData();
            buildAdminMovieList();
            refreshAll();
            showToast('Movie deleted', 'success');
            if (editingMovieId === id)
                cancelForm();
        });
    }

    function showConfirm(msg, onConfirm) {
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:rgba(2,8,16,0.9);z-index:2000;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);';
        overlay.innerHTML = '<div style="background:var(--navy3);border:1px solid var(--border2);padding:28px;max-width:380px;width:90%;text-align:center">' +
        '<div style="font-family:Bebas Neue,sans-serif;font-size:22px;color:var(--red);margin-bottom:12px">Confirm Delete</div>' +
        '<div style="font-size:13px;color:var(--muted);margin-bottom:20px;line-height:1.5">' + msg + '</div>' +
        '<div style="display:flex;gap:10px;justify-content:center">' +
        '<button id="confirm-yes" style="font-family:Barlow Condensed,sans-serif;font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;background:rgba(255,85,51,0.15);border:1px solid var(--red);color:var(--red);padding:10px 20px;cursor:pointer;">Delete</button>' +
        '<button id="confirm-no" style="font-family:Barlow Condensed,sans-serif;font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase;background:var(--card);border:1px solid var(--border);color:var(--muted);padding:10px 20px;cursor:pointer;">Cancel</button>' +
        '</div></div>';
        document.body.appendChild(overlay);
        overlay.querySelector('#confirm-yes').addEventListener('click', function() {
            document.body.removeChild(overlay);
            onConfirm();
        });
        overlay.querySelector('#confirm-no').addEventListener('click', function() {
            document.body.removeChild(overlay);
        });
    }

    function deleteMovie() {
        if (editingMovieId)
            confirmDelete(editingMovieId);
    }

    // ─── TOGGLES ────────────────────────────────────────────────────────────────
    function setToggle(field, val) {
        formToggles[field] = val;
        updateToggles();
    }

    function updateToggles() {
        ['rt', 'num1'].forEach(f => {
            const v = formToggles[f];
            const yesBtn = document.getElementById(f + '-yes');
            const noBtn = document.getElementById(f + '-no');
            const naBtn = document.getElementById(f + '-na');
            if (yesBtn)
                yesBtn.className = 'toggle-btn' + (v === 'YES' ? ' active-yes' : '');
            if (noBtn)
                noBtn.className = 'toggle-btn' + (v === 'NO' ? ' active-no' : '');
            if (naBtn)
                naBtn.className = 'toggle-btn' + (!v ? ' active-na' : '');
        });
    }

    // ─── OMDB SEARCH ────────────────────────────────────────────────────────────
    function onSearchInput() {
        clearTimeout(searchTimeout);
        const q = document.getElementById('search-title-input').value.trim();
        if (q.length < 2) {
            document.getElementById('search-results-area').innerHTML = '';
            return;
        }
        searchTimeout = setTimeout(() => doSearch(q), 500);
    }

    async function doSearch(q) {
        document.getElementById('search-results-area').innerHTML = '<div class="search-loading">Searching…</div>';
        const results = await searchOMDB(q);
        if (!results.length) {
            document.getElementById('search-results-area').innerHTML = '<div class="search-loading">No results found. Try a different title or paste the IMDB ID.</div>';
            return;
        }
        document.getElementById('search-results-area').innerHTML = `<div class="search-results">${results.slice(0, 6).map(r => `
    <div class="search-result" data-imdbid="${r.imdbID}" data-title="${r.Title.replace(/'/g, '&#39;')}">
      ${r.Poster && r.Poster !== 'N/A' ? `<img src="${r.Poster}" class="sr-poster">` : '<div class="sr-poster-ph">🎬</div>'}
      <div class="sr-info">
        <div class="sr-title">${
        r.Title}</div>
        <div class="sr-meta">${r.Year} · ${r.Type}</div>
      </div>
      <button class="sr-select">Select</button>
    </div>`

        ).join('')}</div>`;
        document.getElementById('search-results-area').querySelectorAll('.search-result').forEach(function(el) {
            el.addEventListener('click', function() {
                selectSearchResult(this.dataset.imdbid, this.dataset.title);
            });
        });
    }

    async function selectSearchResult(imdbId, title) {
        document.getElementById('search-results-area').innerHTML = '<div class="search-loading">Fetching details…</div>';
        const d = await fetchOMDB(imdbId, true);
        document.getElementById('search-results-area').innerHTML = '';
        if (!d) {
            showToast('Could not fetch movie details', 'error');
            return;
        }

        // Auto-fill form
        document.getElementById('f-title').value = d.title || title;
        document.getElementById('f-imdbid').value = imdbId;
        if (d.poster && d.poster !== 'N/A' && !document.getElementById('f-poster').value.trim()) {
            document.getElementById('f-poster').value = d.poster;
        }

        // Auto-fill gross from OMDB if available
        if (d.boxOffice) {
            const grossNum = parseInt(d.boxOffice.replace(/[$,]/g, ''));
            if (!isNaN(grossNum) && !document.getElementById('f-gross').value) {
                document.getElementById('f-gross').value = grossNum;
                document.getElementById('omdb-gross-hint').textContent = 'Auto-filled from OMDB: ' + d.boxOffice + ' — edit if needed';
            }
        }

        const rtp = parseOmdbRtPercentString(d.rt);
        if (rtp != null && !document.getElementById('f-rtscore').value.trim()) {
            document.getElementById('f-rtscore').value = String(Math.round(rtp * 10) / 10).replace(/\.0$/, '');
        }

        showOMDBPreview(d, d.title || title);
    }

    async function fetchByImdbId() {
        const id = document.getElementById('imdb-id-input').value.trim();
        if (!id) {
            showToast('Enter an IMDB ID first', 'error');
            return;
        }
        document.getElementById('search-results-area').innerHTML = '<div class="search-loading">Fetching…</div>';
        const d = await fetchOMDB(id, true);
        document.getElementById('search-results-area').innerHTML = '';
        if (!d) {
            showToast('No results for that IMDB ID', 'error');
            return;
        }
        document.getElementById('f-title').value = d.title;
        document.getElementById('f-imdbid').value = id;
        if (d.poster && d.poster !== 'N/A' && !document.getElementById('f-poster').value.trim()) {
            document.getElementById('f-poster').value = d.poster;
        }
        const rtp2 = parseOmdbRtPercentString(d.rt);
        if (rtp2 != null && !document.getElementById('f-rtscore').value.trim()) {
            document.getElementById('f-rtscore').value = String(Math.round(rtp2 * 10) / 10).replace(/\.0$/, '');
        }
        if (d.boxOffice && !document.getElementById('f-gross').value) {
            const grossNum = parseInt(d.boxOffice.replace(/[$,]/g, ''));
            if (!isNaN(grossNum)) {
                document.getElementById('f-gross').value = grossNum;
                document.getElementById('omdb-gross-hint').textContent = 'Auto-filled: ' + d.boxOffice;
            }
        }
        showOMDBPreview(d, d.title);
    }

    function showOMDBPreview(d, fallbackTitle) {
        if (!d) {
            document.getElementById('omdb-preview-area').innerHTML = '';
            return;
        }
        document.getElementById('omdb-preview-area').innerHTML = `
    <div class="omdb-preview">
      ${
        d.poster ? `<img src="${d.poster}" class="omdb-preview-poster">` : '<div style="width:60px;height:88px;background:var(--navy3);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0">🎬</div>'}
      <div class="omdb-preview-info">
        <div class="omdb-preview-title">${
        d.title || fallbackTitle}</div>
        <div class="omdb-preview-meta">${d.year || ''} ${d.runtime ? '· ' + d.runtime : ''}</div>
        <div class="omdb-preview-ratings">
          ${
        d.rt ? `<span class="opr" style="color:${parseInt(d.rt) >= 60 ? 'var(--bonus-rt)' : 'var(--red)'}"><img src="${parseInt(d.rt) >= 60 ? RT_FRESH : RT_ROTTEN}" alt="" style="width:14px;height:14px;vertical-align:middle;margin-right:2px">${d.rt}</span>` : ''}
          ${d.imdb ? `<span class="opr" style="color:#f5c518">⭐ ${d.imdb}/10</span>` : ''}
          ${d.meta ? `<span class="opr" style="color:var(--blue2)">🎯 ${d.meta}/100</span>` : ''}
          ${d.boxOffice ? `<span class="opr" style="color:var(--gold2)">💰 ${d.boxOffice}</span>` : ''}
        </div>
        ${
        d.plot ? `<div style="font-size:10px;color:var(--muted);margin-top:6px;line-height:1.5;font-style:italic">${d.plot.slice(0, 120)}…</div>` : ''}
        <div style="margin-top:8px;font-family:'Barlow Condensed',sans-serif;font-size:9px;color:var(--muted)">IMDB ID: ${d.imdbId || '—'} · <span style="color:var(--green)">✓ This film will be locked to this exact IMDB ID</span></div>
      </div>
    </div>`

        ;
    }

    // ─── REFRESH ALL ─────────────────────────────────────────────────────────────
    function refreshAll() {
        renderNewsletter();
        buildTicker();
        buildStandings();
        buildMoviesPage();
        barsAnimated = false;
        buildStats();
        buildNewsPreview();
    }

    // ─── BADGES ─────────────────────────────────────────────────────────────────
    function typeBadge(type) {
        const m = {
            'In Theaters': 'b-theaters',
            'Limited': 'b-limited',
            'Re-Release': 'b-rerelease'
        };
        return `<span class="badge ${m[type] || 'b-limited'}">${type}</span>`;
    }
    function statusBadge(s) {
        if (!s)
            return '<span class="badge b-upcoming">Upcoming</span>';
        if (s === 'FINISHED')
            return '<span class="badge b-done">Done</span>';
        if (s === 'NEVER RELEASED')
            return '<span class="badge b-never">Never Released</span>';
        return `<span class="badge b-upcoming">${s}</span>`;
    }

    // ─── TOAST ───────────────────────────────────────────────────────────────────
    function showToast(msg, type='') {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast' + (type ? ' ' + type : '');
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    // Wire up static buttons via addEventListener for Safari compatibility

    // ─── SINGLE EVENT DELEGATION ─────────────────────────────────────────────────
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-action]');
        if (btn) {
            var action = btn.dataset.action;
            if (action === 'showAddForm') {
                e.preventDefault();
                showAddForm();
            }
            if (action === 'cancelForm') {
                e.preventDefault();
                cancelForm();
            }
            if (action === 'saveMovie') {
                e.preventDefault();
                saveMovie();
            }
            if (action === 'saveNewsletter') {
                e.preventDefault();
                saveNewsletter();
            }
            if (action === 'deleteMovie') {
                e.preventDefault();
                deleteMovie();
            }
            if (action === 'closeAdmin') {
                e.preventDefault();
                closeAdmin();
            }
            if (action === 'openAdmin') {
                e.preventDefault();
                openAdmin();
            }
            if (action === 'closeMovieModal') {
                e.preventDefault();
                closeMovieModal();
            }
            if (action === 'checkPw') {
                e.preventDefault();
                checkPw();
            }
            if (action === 'showPage') {
                e.preventDefault();
                showPage(btn.dataset.page);
            }
        }
    });

    // RT/Num1 toggles - separate delegation since they have dynamic values
    document.addEventListener('click', function(e) {
        var btn = e.target.closest('[data-toggle-field]');
        if (btn) {
            var field = btn.dataset.toggleField;
            var val = btn.dataset.toggleVal === 'null' ? null : btn.dataset.toggleVal;
            setToggle(field, val);
        }
    });

    // Fetch IMDB ID button
    document.addEventListener('click', function(e) {
        if (e.target.closest('#fetch-imdb-btn')) {
            e.preventDefault();
            fetchByImdbId();
        }
    });

    // Search input
    document.addEventListener('input', function(e) {
        if (e.target.id === 'search-title-input') {
            onSearchInput();
        }
    });

    // Password enter key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && document.getElementById('pw-input') === document.activeElement) {
            checkPw();
        }
        if (e.key === 'Escape') {
            closeMovieModal();
        }
    });

    // Global image fallback for missing/broken URLs.
    document.addEventListener('error', function(e) {
        var el = e.target;
        if (!el || el.tagName !== 'IMG') return;
        if (el.dataset.fallbackApplied === '1') return;
        if (el.src === IMG_PLACEHOLDER) return;
        el.dataset.fallbackApplied = '1';
        el.src = IMG_PLACEHOLDER;
    }, true);

    // Remove password gate and load the dashboard immediately
    var passwordGate = document.getElementById('pw-screen');
    if (passwordGate) {
        passwordGate.style.display = 'none';
    }
    document.getElementById('site-ui').style.display = '';
    document.getElementById('ticker-wrap').style.display = '';
    document.getElementById('site-nav').style.display = '';
    document.getElementById('main-wrap').style.display = '';
    initSite();
    </script>
</body>
</html>
